USE_CLOUD=false
# Local: DATABASE_NAME=local.db. Cloud: NODE selects the matching credentials.
DATABASE_NAME=local.db
NODE=development
DEV_DATABASE_URL=libsql://your-development-database.turso.io
DEV_DATABASE_AUTH_TOKEN=your-development-token
PROD_DATABASE_URL=libsql://your-production-database.turso.io
PROD_DATABASE_AUTH_TOKEN=your-production-token
FRONTEND_ORIGINS=https://your-frontend.vercel.app
JWT_SECRET=use-a-random-secret-with-at-least-32-characters
DIRECTORY=directory-of-sql-migrations
